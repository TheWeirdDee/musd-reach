# Copy to .env (git-ignored) and fill in. Never commit .env. Scripts load it automatically.

# --- Keys (testnet) ---
# Operator: deploys the Base market layer, curates the Reach USDC Vault, runs the market proof.
REACH_PRIVATE_KEY=
# Keeper: gas-only key that refreshes NAV. Also set as the GitHub Actions secret REACH_KEEPER_KEY.
REACH_KEEPER_KEY=
# Relayer: gas-only key that sends tester kits from /api/route-kit. Also set as the Vercel env var REACH_RELAYER_KEY.
REACH_RELAYER_KEY=
REACH_RELAYER_ADDRESS=

# --- Chain access (scripts, verifier, API) ---
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
MEZO_TESTNET_RPC_FALLBACK=
BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_FALLBACK=https://sepolia.base.org
WORMHOLESCAN_API=https://api.testnet.wormholescan.io

# --- Contract deployment only ---
# Optional guardian for wrapper/source pause rights; defaults to the deployer.
REACH_GUARDIAN=

# --- API (apps/api) ---
# api = HTTP only, worker = indexer/reconcile/relay only, all = both (recommended: one service).
ROLE=all
# Listens on API_PORT, else the platform's PORT, else 8787.
API_PORT=
# PostgreSQL connection string; empty uses embedded PGlite at PGLITE_DIR (needs a persistent disk).
DATABASE_URL=
PGLITE_DIR=
# Comma-separated web origins allowed by CORS (the production web URL; no wildcards).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
# Client IP for rate limiting. Set at most one, and only after scripts/check-rate-limit.mjs passes
# against the hosted URL. TRUST_PROXY: addresses/CIDRs of your own reverse proxies.
# CLIENT_IP_HEADER: a header the platform edge sets and clients cannot forge (Railway: x-real-ip;
# Render, behind Cloudflare: cf-connecting-ip). Empty = socket address.
TRUST_PROXY=
CLIENT_IP_HEADER=
# Optional relayer: path to a file holding a dedicated, low-balance key. Empty = track only;
# users deliver messages themselves from the transfer tracker.
RELAYER_KEY_FILE=
LOG_LEVEL=info

# --- Web (apps/web), read at build time ---
NEXT_PUBLIC_API_URL=http://localhost:8787
# For a web-only local template, see apps/web/.env.example.
# On Vercel use https://musd-reach-api.onrender.com instead of localhost.
# WalletConnect is not offered; no project ID or site URL variable is required.
NEXT_PUBLIC_MEZO_RPC=
NEXT_PUBLIC_BASE_RPC=
# Test-only, `next dev` only. A production build refuses to start if any is set:
#   NEXT_PUBLIC_E2E_ACCOUNT, NEXT_PUBLIC_REACH_DEPLOYMENT, NEXT_PUBLIC_NETWORK_MODE
# Optional: overrides the Reown/WalletConnect Cloud project id baked into the wallet chooser
# (a public client identifier, not a secret). Empty keeps the built-in one.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
