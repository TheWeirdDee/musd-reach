# Local use: copy this file to apps/web/.env.local (git-ignored).
# Hosted use: add these values in Vercel Project Settings > Environment Variables.
# These are public browser endpoints, not secrets.
NEXT_PUBLIC_API_URL=https://musd-reach-api.onrender.com
NEXT_PUBLIC_MEZO_RPC=https://rpc.test.mezo.org
NEXT_PUBLIC_BASE_RPC=https://base-sepolia-rpc.publicnode.com

# Vercel also needs ENABLE_EXPERIMENTAL_COREPACK=1 for the configured install command.
# No private key, relayer key, database URL, WalletConnect ID or site URL is required here.
# Never set NEXT_PUBLIC_E2E_ACCOUNT, NEXT_PUBLIC_REACH_DEPLOYMENT,
# NEXT_PUBLIC_NETWORK_MODE or NEXT_PUBLIC_E2E_WALLET_TESTS on Vercel.
