{
  "name": "@musd-reach/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent, read-only MUSD Reach verifier. Reads chains directly; trusts no Reach server.",
  "bin": { "reach-verify": "./src/cli.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli.ts"
  },
  "dependencies": {
    "@musd-reach/sdk": "workspace:*",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
